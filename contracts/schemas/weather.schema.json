{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "WeatherHour": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "rain_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rain Mm"
        },
        "wind_kph": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wind Kph"
        }
      },
      "required": [
        "at"
      ],
      "title": "WeatherHour",
      "type": "object"
    },
    "WeatherPeriod": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "maximum": 99,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "temperature_min_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Min C"
        },
        "temperature_max_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Max C"
        },
        "rain_probability_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rain Probability Pct"
        },
        "rain_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rain Mm"
        },
        "wind_kph": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wind Kph"
        },
        "uv_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uv Index"
        }
      },
      "title": "WeatherPeriod",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "current": {
      "$ref": "#/$defs/WeatherPeriod"
    },
    "today": {
      "$ref": "#/$defs/WeatherPeriod"
    },
    "tomorrow": {
      "$ref": "#/$defs/WeatherPeriod"
    },
    "sunrise": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sunrise"
    },
    "sunset": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sunset"
    },
    "hourly": {
      "items": {
        "$ref": "#/$defs/WeatherHour"
      },
      "maxItems": 72,
      "title": "Hourly",
      "type": "array"
    }
  },
  "required": [
    "observed_at",
    "timezone",
    "source",
    "current",
    "today",
    "tomorrow"
  ],
  "title": "WeatherSnapshot",
  "type": "object"
}
