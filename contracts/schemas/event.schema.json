{
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "starts_at": {
      "format": "date-time",
      "title": "Starts At",
      "type": "string"
    },
    "ends_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ends At"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 280,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "person": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Person"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "all_day": {
      "default": false,
      "title": "All Day",
      "type": "boolean"
    },
    "is_protected": {
      "default": false,
      "title": "Is Protected",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "title",
    "starts_at",
    "source"
  ],
  "title": "Event",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
