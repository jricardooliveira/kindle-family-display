{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 280,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "category": {
      "enum": [
        "portugal",
        "national",
        "world"
      ],
      "title": "Category",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "id",
    "title",
    "published_at",
    "source",
    "category"
  ],
  "title": "NewsItem",
  "type": "object"
}
