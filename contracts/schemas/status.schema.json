{
  "$defs": {
    "ScreenStatus": {
      "additionalProperties": false,
      "properties": {
        "screen": {
          "enum": [
            "news-weather",
            "news",
            "family",
            "calendar",
            "nearby",
            "photo"
          ],
          "title": "Screen",
          "type": "string"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        }
      },
      "required": [
        "screen",
        "width",
        "height",
        "stale"
      ],
      "title": "ScreenStatus",
      "type": "object"
    },
    "SourceStatus": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "calendar",
            "weather",
            "rss",
            "events"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_attempt_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Attempt At"
        },
        "last_success_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success At"
        },
        "stale": {
          "default": true,
          "title": "Stale",
          "type": "boolean"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "item_count": {
          "default": 0,
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "SourceStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "screens": {
      "items": {
        "enum": [
          "news-weather",
          "news",
          "family",
          "calendar",
          "nearby",
          "photo"
        ],
        "type": "string"
      },
      "title": "Screens",
      "type": "array"
    },
    "generated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "stale_sources": {
      "items": {
        "type": "string"
      },
      "title": "Stale Sources",
      "type": "array"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "navigation_order": {
      "items": {
        "enum": [
          "news-weather",
          "news",
          "family",
          "calendar",
          "nearby",
          "photo"
        ],
        "type": "string"
      },
      "title": "Navigation Order",
      "type": "array"
    },
    "demo": {
      "default": true,
      "title": "Demo",
      "type": "boolean"
    },
    "screen_status": {
      "items": {
        "$ref": "#/$defs/ScreenStatus"
      },
      "title": "Screen Status",
      "type": "array"
    },
    "source_status": {
      "items": {
        "$ref": "#/$defs/SourceStatus"
      },
      "title": "Source Status",
      "type": "array"
    }
  },
  "required": [
    "ok",
    "timezone",
    "screens"
  ],
  "title": "Status",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
